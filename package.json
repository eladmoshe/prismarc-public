{
  "name": "prismarc",
  "version": "5.2.0",
  "description": "Organize tabs into spaces, pin bookmarks, and search tabs and history from a sidebar.",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "test": "npm run test:unit",
    "dev": "vite build --config vite.config.dev.js --watch",
    "build": "vite build",
    "build:local": "npm run build && npm run verify:build && npm run zip",
    "verify:build": "node scripts/fork/verify-build.js",
    "build:zip": "npm run build:local",
    "zip": "node scripts/zip.js",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-dev *.zip",
    "info": "node scripts/build-info.js",
    "lint": "eslint .",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:security": "node --test tests/unit/security.test.js tests/unit/url-copy.test.js"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "archiver": "^6.0.1",
    "eslint": "^10.15.0",
    "fs-extra": "^11.2.0",
    "globals": "^17.14.0",
    "jest": "^30.2.0",
    "puppeteer": "^25.17.0",
    "vite": "^6.0.0"
  },
  "keywords": [
    "chrome-extension",
    "tabs",
    "productivity"
  ],
  "author": "Nisarg Kolhe",
  "license": "GPL-3.0",
  "private": true,
  "contributors": [
    "PrismArc contributors"
  ]
}
