{
  "name": "arcify",
  "version": "5.2.0",
  "description": "A sidebar extension that replicates Arc browser's tab management system",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "npm run test:unit",
    "dev": "vite build --config vite.config.dev.js --watch",
    "build": "vite build",
    "build:local": "npm run build && npm run verify:build && npm run zip",
    "verify:build": "node scripts/fork/verify-build.js",
    "build:zip": "npm run build && npm run zip",
    "zip": "node scripts/zip.js",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-dev *.zip",
    "info": "node scripts/build-info.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:security": "node --test tests/unit/security.test.js tests/unit/url-copy.test.js"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "archiver": "^6.0.1",
    "fs-extra": "^11.2.0",
    "jest": "^30.2.0",
    "puppeteer": "^25.17.0",
    "vite": "^6.0.0"
  },
  "keywords": [
    "chrome-extension",
    "tabs",
    "arc-browser",
    "productivity"
  ],
  "author": "Nisarg Kolhe",
  "license": "GPL-3.0"
}
